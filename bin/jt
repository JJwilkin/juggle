#!/usr/bin/env bash
# juggle (jt) — ticket context manager
# https://github.com/JJwilkin/juggle-task

set -euo pipefail

JT_VERSION="0.2.0"
JT_CONFIG="$HOME/.jt-config"
JT_ENGINE_FILE="$HOME/.jt-engine"
JT_UPDATE_CACHE="$HOME/.jt-update-check"
JT_UPDATE_INTERVAL=86400  # check once per day
JT_SYNC_CACHE="$HOME/.jt-sync-check"
JT_SYNC_INTERVAL=3600     # refresh Linear status at most once per hour
DEFAULT_TICKETS_DIR="$HOME/juggle-task"
REPO="JJwilkin/juggle-task"
CODEX_HOME_DEFAULT="$HOME/.codex"
CLAUDE_HOME="$HOME/.claude"

# Statuses that hide a ticket from the default `jt ls` / `jt open` views.
JT_DONE_STATUSES_RE='^(archived|closed|done|cancelled|canceled|completed|duplicate)$'

_jt_tickets_dir() {
  local dir
  dir=$(cat "$JT_CONFIG" 2>/dev/null || true)
  [[ -z "$dir" ]] && dir="$DEFAULT_TICKETS_DIR"
  echo "$dir"
}

# Resolve the active engine: explicit override > stored config > auto-detect.
# Returns "claude" or "codex".
_jt_engine() {
  local engine="${JT_ENGINE_OVERRIDE:-}"
  [[ -z "$engine" && -f "$JT_ENGINE_FILE" ]] && engine=$(cat "$JT_ENGINE_FILE" 2>/dev/null | tr -d '[:space:]')
  if [[ -z "$engine" ]]; then
    if command -v claude >/dev/null 2>&1; then
      engine="claude"
    elif command -v codex >/dev/null 2>&1; then
      engine="codex"
    else
      engine="claude"  # fall back; commands will fail loudly with a clear error
    fi
  fi
  case "$engine" in
    claude|codex) echo "$engine" ;;
    *) echo "claude" ;;
  esac
}

_jt_engine_bin() {
  case "$1" in
    claude) echo "claude" ;;
    codex)  echo "codex" ;;
  esac
}

# Locate the engine's skills directory.
_jt_engine_skills_dir() {
  case "$1" in
    claude) echo "$CLAUDE_HOME/skills" ;;
    codex)  echo "${CODEX_HOME:-$CODEX_HOME_DEFAULT}/skills" ;;
  esac
}

# Run a slash-command in a fresh interactive session, with optional inline skill body.
# Args: <engine> <session-name> <add-dir> <slash-command-with-args>
_jt_run_skill_fresh() {
  local engine="$1" sess_name="$2" dir="$3" slash="$4"
  local skill_name="${slash%% *}"  # /jt-init -> /jt-init
  skill_name="${skill_name#/}"      # /jt-init -> jt-init
  local skill_file
  skill_file="$(_jt_engine_skills_dir "$engine")/$skill_name/SKILL.md"

  case "$engine" in
    claude)
      if [[ -f "$skill_file" ]]; then
        local skill_body
        skill_body=$(awk 'BEGIN{p=0;n=0} /^---/{n++;if(n==2){p=1};next} p{print}' "$skill_file")
        # Substitute $ARGUMENTS with the slash args portion only
        local slash_args="${slash#* }"; [[ "$slash_args" == "$slash" ]] && slash_args=""
        skill_body="${skill_body//\$ARGUMENTS/$slash_args}"
        claude -n "$sess_name" --add-dir "$dir" \
          --append-system-prompt "$skill_body" \
          "$slash"
      else
        claude -n "$sess_name" --add-dir "$dir" "$slash"
      fi
      ;;
    codex)
      # Codex auto-discovers skills from ~/.codex/skills — no system-prompt injection needed.
      codex --add-dir "$dir" "$slash"
      ;;
  esac
}

# Resume a saved session.  Args: <engine> <cwd> <uuid>
_jt_run_resume() {
  local engine="$1" cwd="$2" uuid="$3"
  cd "$cwd" || return 1
  case "$engine" in
    claude) claude --resume "$uuid" ;;
    codex)  codex resume "$uuid" ;;
  esac
}

# Start a brand-new (non-skill) session with no initial prompt.
# Args: <engine> <session-name> <add-dir>
_jt_run_fresh() {
  local engine="$1" sess_name="$2" dir="$3"
  case "$engine" in
    claude) claude -n "$sess_name" --add-dir "$dir" ;;
    codex)  codex --add-dir "$dir" ;;
  esac
}

# Run a slash-command in foreground, non-interactive (for `jt sync`).
# Args: <engine> <add-dir> <slash-command>
_jt_run_exec() {
  local engine="$1" dir="$2" slash="$3"
  case "$engine" in
    claude)
      local skill_file="$CLAUDE_HOME/skills/jt-sync/SKILL.md"
      if [[ -f "$skill_file" ]]; then
        local skill_body
        skill_body=$(awk 'BEGIN{p=0;n=0} /^---/{n++;if(n==2){p=1};next} p{print}' "$skill_file")
        claude -p --add-dir "$dir" --append-system-prompt "$skill_body" "$slash"
      else
        claude -p --add-dir "$dir" "$slash"
      fi
      ;;
    codex)
      codex exec --add-dir "$dir" --skip-git-repo-check "$slash"
      ;;
  esac
}

_jt_normalize_id() {
  echo "$1" | tr '[:lower:]' '[:upper:]'
}

_jt_get_branch() {
  local context_file="$1"
  grep "Working branch" "$context_file" 2>/dev/null | head -1 | sed 's/.*`\(.*\)`.*/\1/'
}

_jt_get_repo() {
  local context_file="$1"
  grep "^\*\*Repo\*\*" "$context_file" 2>/dev/null | head -1 | sed 's/\*\*Repo\*\*: //'
}

_jt_get_status() {
  local context_file="$1"
  grep "^\*\*Status\*\*" "$context_file" 2>/dev/null | head -1 | sed 's/\*\*Status\*\*: //' | tr '[:upper:]' '[:lower:]' | tr -d ' '
}

_jt_is_done_status() {
  [[ "$1" =~ $JT_DONE_STATUSES_RE ]]
}

# Fire a background non-interactive /jt-sync to refresh Linear statuses.
# TTL-gated so it runs at most once per JT_SYNC_INTERVAL.
_jt_background_sync() {
  local engine
  engine=$(_jt_engine)
  command -v "$(_jt_engine_bin "$engine")" >/dev/null 2>&1 || return 0

  local now cached_time
  now=$(date +%s)
  if [[ -f "$JT_SYNC_CACHE" ]]; then
    read -r cached_time < "$JT_SYNC_CACHE" 2>/dev/null || true
    if [[ -n "${cached_time:-}" ]] && (( now - cached_time < JT_SYNC_INTERVAL )); then
      return 0
    fi
  fi

  local skills_dir
  skills_dir=$(_jt_engine_skills_dir "$engine")
  [[ -f "$skills_dir/jt-sync/SKILL.md" ]] || return 0

  local dir
  dir=$(_jt_tickets_dir)

  # Pre-stamp the cache so concurrent commands don't all fire syncs.
  printf '%s\n' "$now" > "$JT_SYNC_CACHE"

  ( _jt_run_exec "$engine" "$dir" "/jt-sync" >/dev/null 2>&1 ) &
  disown 2>/dev/null || true
}

# Print a notice if a newer version is cached, then kick off a background
# refresh of the cache. Never blocks — network call is async.
_jt_check_update() {
  local now cached_time cached_version
  now=$(date +%s)

  # Read whatever is cached (instant, no network)
  if [[ -f "$JT_UPDATE_CACHE" ]]; then
    read -r cached_time cached_version < "$JT_UPDATE_CACHE" 2>/dev/null || true
    if [[ -n "$cached_version" && "$cached_version" != "$JT_VERSION" ]]; then
      printf '\n  Update available: %s → %s  (run '"'"'jt upgrade'"'"' to update)\n' \
        "$JT_VERSION" "$cached_version" >&2
    fi
    # Cache still fresh — no background fetch needed
    if [[ -n "${cached_time:-}" ]] && (( now - cached_time < JT_UPDATE_INTERVAL )); then
      return 0
    fi
  fi

  # Refresh cache in background — never blocks the current command
  (
    local latest
    latest=$(curl -fsSL --max-time 3 \
      "https://raw.githubusercontent.com/${REPO}/main/VERSION" \
      2>/dev/null | tr -d '[:space:]' || true)
    [[ -n "$latest" ]] && printf '%s %s\n' "$(date +%s)" "$latest" > "$JT_UPDATE_CACHE"
  ) &
  disown 2>/dev/null || true
}

_jt_pick_ticket() {
  local dir="$1"
  local include_all="${2:-0}"
  local ids=() titles=()
  local globs=("$dir"/*/CONTEXT.md)
  [[ "$include_all" == "1" ]] && globs+=("$dir"/completed/*/CONTEXT.md)

  for context in "${globs[@]}"; do
    [[ -f "$context" ]] || continue
    local id title status parent
    id=$(basename "$(dirname "$context")")
    parent=$(basename "$(dirname "$(dirname "$context")")")
    # Skip 'projects' and 'completed' dirs themselves; only ticket subdirs.
    [[ "$id" == "projects" || "$id" == "completed" ]] && continue
    if [[ "$include_all" != "1" ]]; then
      status=$(_jt_get_status "$context")
      _jt_is_done_status "$status" && continue
    fi
    title=$(head -1 "$context" 2>/dev/null \
      | sed 's/^# //' \
      | sed 's/ — Agent Context$//' \
      | sed 's/^[A-Za-z0-9-]*: //')
    if [[ "$parent" == "completed" ]]; then
      ids+=("$id")
      titles+=("$title  (completed)")
    else
      ids+=("$id")
      titles+=("$title")
    fi
  done

  if [[ ${#ids[@]} -eq 0 ]]; then
    if [[ "$include_all" == "1" ]]; then
      echo "No tickets found. Run 'jt init <ticket>' first."
    else
      echo "No active tickets. (Try 'jt open --all' to include completed tickets, or 'jt init <ticket>'.)"
    fi
    exit 1
  fi

  echo "Available tickets:"
  echo ""
  for i in "${!ids[@]}"; do
    printf "  %d) %-14s %s\n" "$((i+1))" "${ids[$i]}" "${titles[$i]}"
  done
  echo ""
  read -rp "Select (1-${#ids[@]}): " sel

  [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#ids[@]} )) || {
    echo "Invalid selection."
    exit 1
  }

  _PICKED_TICKET="${ids[$((sel-1))]}"
}

_jt_checkout() {
  local ticket_id="$1" context_file="$2"
  local branch repo
  branch=$(_jt_get_branch "$context_file")
  repo=$(_jt_get_repo "$context_file")

  if [[ -n "$branch" && -n "$repo" && "$repo" != "(not in a git repo)" && "$repo" != "(none)" && -d "$repo" ]]; then
    if ! git -C "$repo" diff --quiet 2>/dev/null || ! git -C "$repo" diff --cached --quiet 2>/dev/null; then
      echo "Warning: $repo has uncommitted changes — branch not switched. Commit or stash first."
    else
      git -C "$repo" fetch origin --quiet 2>/dev/null || true
      git -C "$repo" checkout "$branch" 2>/dev/null \
        || git -C "$repo" checkout --track "origin/$branch" 2>/dev/null \
        || echo "Warning: could not switch to $branch (may already be on it)"
      echo "Branch: $branch"
    fi
  fi
}

cmd_help() {
  cat <<EOF
juggle (jt) v${JT_VERSION} — ticket context manager for Claude Code & Codex

Usage:
  jt init   <ticket> [--project <id>]   create ticket context (launches the active engine)
  jt update                              save session progress to CONTEXT.md
  jt open   [ticket] [--all]             resume the session (include completed with --all)
  jt ls     [--all]                      list active tickets (include completed with --all)
  jt sync                                refresh ticket statuses from Linear (foreground)
  jt project init <id-or-url>            create a new project / epic
  jt project ls                          list all projects
  jt project show <id>                   show a project's PROJECT.md
  jt engine                              show active engine (claude or codex)
  jt engine set <claude|codex>           pin a default engine
  jt upgrade                             upgrade jt to the latest version
  jt config                              show current tickets directory
  jt config set <path>                   set tickets directory
  jt help                                show this message

Skills (installed for both engines): /jt-init, /jt-update, /jt-open, /jt-ls, /jt-project-init, /jt-sync

Docs: https://github.com/JJwilkin/juggle-task
EOF
}

cmd_init() {
  # Parse args: <ticket> [--project <id>]
  local ticket="" project_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)
        project_id="${2:-}"
        shift 2
        ;;
      *)
        if [[ -z "$ticket" ]]; then
          ticket="$1"
        fi
        shift
        ;;
    esac
  done
  [[ -z "$ticket" ]] && { echo "Usage: jt init <TICKET-ID or URL> [--project <id>]"; exit 1; }

  local dir engine
  dir=$(_jt_tickets_dir)
  engine=$(_jt_engine)
  local args="$ticket"
  [[ -n "$project_id" ]] && args="$args --project $project_id"

  echo "Launching $engine to initialize $ticket${project_id:+ (project: $project_id)}..."
  echo ""
  _jt_run_skill_fresh "$engine" "$ticket" "$dir" "/jt-init $args"
}

cmd_project() {
  local sub="${1:-}"
  shift || true
  local dir
  dir=$(_jt_tickets_dir)

  case "$sub" in
    init)
      local arg="${1:-}"
      [[ -z "$arg" ]] && { echo "Usage: jt project init <ID-or-Linear-URL>"; exit 1; }
      local engine
      engine=$(_jt_engine)
      echo "Launching $engine to initialize project $arg..."
      echo ""
      _jt_run_skill_fresh "$engine" "Project: $arg" "$dir" "/jt-project-init $arg"
      ;;
    ls)
      local found=0
      for project_file in "$dir"/projects/*/PROJECT.md; do
        [[ -f "$project_file" ]] || continue
        found=1; break
      done
      if [[ $found -eq 0 ]]; then
        echo "No projects found at: $dir/projects/"
        echo "Run 'jt project init <id>' to create your first project."
        return
      fi
      printf "%-14s  %-50s  %s\n" "PROJECT" "TITLE" "STATUS"
      printf "%-14s  %-50s  %s\n" "-------" "-----" "------"
      for project_file in "$dir"/projects/*/PROJECT.md; do
        [[ -f "$project_file" ]] || continue
        local id title status
        id=$(basename "$(dirname "$project_file")")
        title=$(head -1 "$project_file" 2>/dev/null | sed 's/^# //' | sed 's/^[A-Za-z0-9-]*: //')
        status=$(grep "^\*\*Status\*\*" "$project_file" 2>/dev/null | head -1 | sed 's/\*\*Status\*\*: //')
        printf "%-14s  %-50s  %s\n" "$id" "${title:0:50}" "${status:-(unknown)}"
      done
      ;;
    show)
      local id="${1:-}"
      [[ -z "$id" ]] && { echo "Usage: jt project show <id>"; exit 1; }
      local pfile="$dir/projects/$id/PROJECT.md"
      if [[ ! -f "$pfile" ]]; then
        # case-insensitive fallback: try uppercase
        local id_up
        id_up=$(_jt_normalize_id "$id")
        pfile="$dir/projects/$id_up/PROJECT.md"
      fi
      if [[ -f "$pfile" ]]; then
        cat "$pfile"
      else
        echo "No project found with id: $id"
        echo "Run 'jt project ls' to see available projects."
        exit 1
      fi
      ;;
    "")
      echo "Usage: jt project <init|ls|show> [args]"
      exit 1
      ;;
    *)
      echo "Unknown project subcommand: $sub"
      echo "Usage: jt project <init|ls|show> [args]"
      exit 1
      ;;
  esac
}

cmd_update() {
  local dir engine
  dir=$(_jt_tickets_dir)
  engine=$(_jt_engine)
  echo "Launching $engine to save session context..."
  echo ""
  case "$engine" in
    claude) claude --add-dir "$dir" "/jt-update $*" ;;
    codex)  codex --add-dir "$dir" "/jt-update $*" ;;
  esac
}

cmd_ls() {
  local include_all=0
  for arg in "$@"; do
    [[ "$arg" == "--all" ]] && include_all=1
  done

  local dir
  dir=$(_jt_tickets_dir)
  _jt_background_sync

  local globs=("$dir"/*/CONTEXT.md)
  [[ "$include_all" == "1" ]] && globs+=("$dir"/completed/*/CONTEXT.md)

  local rows=()
  for context in "${globs[@]}"; do
    [[ -f "$context" ]] || continue
    local id parent
    id=$(basename "$(dirname "$context")")
    parent=$(basename "$(dirname "$(dirname "$context")")")
    [[ "$id" == "projects" || "$id" == "completed" ]] && continue
    if [[ "$include_all" != "1" ]]; then
      local status
      status=$(_jt_get_status "$context")
      _jt_is_done_status "$status" && continue
    fi
    local title last_updated tag=""
    title=$(head -1 "$context" 2>/dev/null | sed 's/^# //' | sed 's/ — Agent Context$//' | sed 's/^[A-Za-z0-9-]*: //')
    last_updated=$(grep "^\*\*Last updated\*\*" "$context" 2>/dev/null | head -1 | sed 's/\*\*Last updated\*\*: //')
    [[ "$parent" == "completed" ]] && tag="  (completed)"
    rows+=("$(printf '%-14s  %-40s  %s%s\n' "$id" "${title:0:40}" "${last_updated:-(unknown)}" "$tag")")
  done

  if [[ ${#rows[@]} -eq 0 ]]; then
    if [[ "$include_all" == "1" ]]; then
      echo "No tickets found at: $dir"
      echo "Run 'jt init <ticket>' to create your first ticket."
    else
      echo "No active tickets. (Try 'jt ls --all' to include completed tickets.)"
    fi
    return
  fi

  printf "%-14s  %-40s  %s\n" "TICKET" "TITLE" "LAST UPDATED"
  printf "%-14s  %-40s  %s\n" "------" "-----" "------------"
  printf '%s\n' "${rows[@]}"
}

# Resolve a ticket ID to its CONTEXT.md path, checking both active and completed dirs.
# Sets _RESOLVED_TICKET_ID and _RESOLVED_CONTEXT_FILE. Returns 1 if not found.
_jt_resolve_ticket() {
  local dir="$1" raw="$2"
  for candidate in "$raw" "$(_jt_normalize_id "$raw")"; do
    if [[ -f "$dir/$candidate/CONTEXT.md" ]]; then
      _RESOLVED_TICKET_ID="$candidate"
      _RESOLVED_CONTEXT_FILE="$dir/$candidate/CONTEXT.md"
      return 0
    fi
    if [[ -f "$dir/completed/$candidate/CONTEXT.md" ]]; then
      _RESOLVED_TICKET_ID="$candidate"
      _RESOLVED_CONTEXT_FILE="$dir/completed/$candidate/CONTEXT.md"
      return 0
    fi
  done
  return 1
}

cmd_open() {
  local raw_id="" include_all=0
  for arg in "$@"; do
    case "$arg" in
      --all) include_all=1 ;;
      *)     [[ -z "$raw_id" ]] && raw_id="$arg" ;;
    esac
  done

  local dir
  dir=$(_jt_tickets_dir)
  _jt_background_sync

  if [[ -z "$raw_id" ]]; then
    _jt_pick_ticket "$dir" "$include_all"
    raw_id="$_PICKED_TICKET"
    echo ""
  fi

  if ! _jt_resolve_ticket "$dir" "$raw_id"; then
    echo "No context found for $raw_id. Run 'jt init $raw_id' first."
    exit 1
  fi
  local ticket_id="$_RESOLVED_TICKET_ID"
  local context_file="$_RESOLVED_CONTEXT_FILE"

  _jt_checkout "$ticket_id" "$context_file"

  local session_file
  session_file="$(dirname "$context_file")/.session"

  # .session formats supported (in order of preference):
  #   3-line: <engine>\n<cwd>\n<uuid>
  #   2-line (legacy): <cwd>\n<uuid>  -> defaults to claude engine
  if [[ -f "$session_file" ]]; then
    local line1 line2 line3 sess_engine sess_dir sess_uuid
    line1=$(sed -n '1p' "$session_file")
    line2=$(sed -n '2p' "$session_file")
    line3=$(sed -n '3p' "$session_file")
    if [[ "$line1" == "claude" || "$line1" == "codex" ]]; then
      sess_engine="$line1"; sess_dir="$line2"; sess_uuid="$line3"
    else
      sess_engine="claude"; sess_dir="$line1"; sess_uuid="$line2"
    fi
    if [[ -n "$sess_dir" && -n "$sess_uuid" && -d "$sess_dir" ]]; then
      echo "Resuming $sess_engine session for $ticket_id..."
      echo ""
      _jt_run_resume "$sess_engine" "$sess_dir" "$sess_uuid"
      return
    fi
  fi

  # No saved session — start a fresh named session in the active engine
  local engine session_name
  engine=$(_jt_engine)
  session_name=$(head -1 "$context_file" | sed 's/^# //' | sed 's/ — Agent Context$//')

  echo "Starting new $engine session for $ticket_id..."
  echo ""
  _jt_run_fresh "$engine" "$session_name" "$dir"
}

cmd_sync() {
  local dir engine
  dir=$(_jt_tickets_dir)
  engine=$(_jt_engine)
  echo "Syncing ticket statuses from Linear via $engine..."
  echo ""
  rm -f "$JT_SYNC_CACHE"  # foreground sync overrides any TTL gate
  _jt_run_exec "$engine" "$dir" "/jt-sync"
  printf '%s\n' "$(date +%s)" > "$JT_SYNC_CACHE"
}

cmd_upgrade() {
  echo "Upgrading Juggle..."
  echo ""
  if curl -fsSL "https://raw.githubusercontent.com/${REPO}/main/install.sh" | bash; then
    rm -f "$JT_UPDATE_CACHE"
    echo ""
    echo "Upgraded to the latest version."
    echo "Restart Claude Code to load updated skills."
  else
    echo "Upgrade failed. Check your connection and try again."
    exit 1
  fi
}

cmd_engine() {
  local subcmd="${1:-}"
  case "$subcmd" in
    set)
      local new="${2:-}"
      [[ "$new" != "claude" && "$new" != "codex" ]] && {
        echo "Usage: jt engine set <claude|codex>"
        exit 1
      }
      printf '%s\n' "$new" > "$JT_ENGINE_FILE"
      echo "Engine set to: $new"
      ;;
    reset|clear)
      rm -f "$JT_ENGINE_FILE"
      echo "Engine setting cleared (will auto-detect)."
      ;;
    "")
      local current
      current=$(_jt_engine)
      echo "Active engine: $current"
      if [[ -f "$JT_ENGINE_FILE" ]]; then
        echo "Source:        $JT_ENGINE_FILE"
      else
        echo "Source:        auto-detect (claude > codex)"
      fi
      echo ""
      echo "Available CLIs on PATH:"
      command -v claude >/dev/null 2>&1 && echo "  claude  $(claude --version 2>/dev/null | head -1)"
      command -v codex >/dev/null 2>&1  && echo "  codex   $(codex --version 2>/dev/null | head -1)"
      ;;
    *)
      echo "Usage: jt engine [set <claude|codex> | reset]"
      exit 1
      ;;
  esac
}

cmd_config() {
  local subcmd="${1:-}"
  local dir
  dir=$(_jt_tickets_dir)

  case "$subcmd" in
    set)
      local new_path="${2:-}"
      [[ -z "$new_path" ]] && { echo "Usage: jt config set <path>"; exit 1; }
      new_path="${new_path/#\~/$HOME}"
      echo "$new_path" > "$JT_CONFIG"
      mkdir -p "$new_path"
      echo "Tickets directory set to: $new_path"
      ;;
    "")
      echo "Tickets directory: $dir"
      echo "Version:           $JT_VERSION"
      if [[ -f "$JT_CONFIG" ]]; then
        echo "Config file:       $JT_CONFIG"
      else
        echo "Config file:       (not set, using default)"
      fi
      ;;
    *)
      echo "Unknown config subcommand: $subcmd"
      echo "Usage: jt config [set <path>]"
      exit 1
      ;;
  esac
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    init)           cmd_init "$@" ;;
    update)         cmd_update "$@" ;;
    open)           cmd_open "$@" ;;
    ls)             cmd_ls "$@" ;;
    sync)           cmd_sync ;;
    project)        cmd_project "$@" ;;
    engine)         cmd_engine "$@" ;;
    upgrade)        cmd_upgrade ;;
    config)         cmd_config "$@" ;;
    help|--help|-h) cmd_help ;;
    version|--version|-v) echo "jt $JT_VERSION" ;;
    *)
      echo "Unknown command: $cmd"
      echo "Run 'jt help' for usage."
      exit 1
      ;;
  esac

  # Check for updates after every command except upgrade/help/version
  case "$cmd" in
    upgrade|help|--help|-h|version|--version|-v) ;;
    *) _jt_check_update ;;
  esac
}

main "$@"
